local t = require("./lib/t")
local load = require("./lib/load")

-- Auto deposit: a carrying player who walks into his own base puts the treasure away, no key needed.
t.test("deposit: carrying inside own base, not slipping, no recent try -> deposit", function()
	local Rules = load("DepositRules")
	t.eq(Rules.shouldDeposit({ carrying = true, insideBase = true, slipping = false, secondsSinceTry = 100 }), true)
end)

t.test("deposit: nothing happens when not carrying, outside the base or slipping", function()
	local Rules = load("DepositRules")
	t.eq(Rules.shouldDeposit({ carrying = false, insideBase = true, slipping = false, secondsSinceTry = 100 }), false)
	t.eq(Rules.shouldDeposit({ carrying = true, insideBase = false, slipping = false, secondsSinceTry = 100 }), false)
	t.eq(Rules.shouldDeposit({ carrying = true, insideBase = true, slipping = true, secondsSinceTry = 100 }), false)
end)

t.test("deposit: a failed try waits DEPOSIT_RETRY seconds before the next one", function()
	local Rules, Config = load("DepositRules"), load("Config")
	t.eq(Rules.shouldDeposit({ carrying = true, insideBase = true, slipping = false, secondsSinceTry = Config.DEPOSIT_RETRY - 0.1 }), false)
	t.eq(Rules.shouldDeposit({ carrying = true, insideBase = true, slipping = false, secondsSinceTry = Config.DEPOSIT_RETRY }), true)
end)

t.test("deposit: broken input never deposits", function()
	local Rules = load("DepositRules")
	t.eq(Rules.shouldDeposit({ carrying = true, insideBase = true, slipping = false, secondsSinceTry = 0 / 0 }), false)
	t.eq(Rules.shouldDeposit(nil :: any), false)
end)

-- Shield: step on the pad in your base, 10 seconds nobody can steal from you, then a cooldown.
t.test("shield: isActive only before shieldUntil", function()
	local Rules = load("ShieldRules")
	t.eq(Rules.isActive(100, 105), true)
	t.eq(Rules.isActive(105, 105), false)
	t.eq(Rules.isActive(100, 0), false)
	t.eq(Rules.isActive(100, nil :: any), false)
	t.eq(Rules.isActive(0 / 0, 105), false)
end)

t.test("shield: canActivate only when readyAt has passed", function()
	local Rules = load("ShieldRules")
	t.eq(Rules.canActivate(100, 0), true)
	t.eq(Rules.canActivate(100, 100), true)
	t.eq(Rules.canActivate(99.9, 100), false)
	t.eq(Rules.canActivate(100, nil :: any), true)
	t.eq(Rules.canActivate(0 / 0, 0), false)
end)

t.test("shield: activate gives SHIELD_SECONDS of shield and a cooldown after that", function()
	local Rules, Config = load("ShieldRules"), load("Config")
	local result = Rules.activate(100)
	t.eq(result.shieldUntil, 100 + Config.SHIELD_SECONDS)
	t.eq(result.readyAt, 100 + Config.SHIELD_SECONDS + Config.SHIELD_COOLDOWN)
	t.eq(Rules.isActive(100 + Config.SHIELD_SECONDS - 0.01, result.shieldUntil), true)
	t.eq(Rules.canActivate(result.shieldUntil, result.readyAt), false)
	t.eq(Rules.canActivate(result.readyAt, result.readyAt), true)
end)

t.test("shield: onPad uses flat distance and a height limit", function()
	local Rules, Config = load("ShieldRules"), load("Config")
	t.eq(Rules.onPad(0, 0, 0), true)
	t.eq(Rules.onPad(Config.SHIELD_PAD_RADIUS, 2, 0), true)
	t.eq(Rules.onPad(Config.SHIELD_PAD_RADIUS + 0.1, 2, 0), false)
	t.eq(Rules.onPad(0, 50, 0), false)
	t.eq(Rules.onPad(0 / 0, 0, 0), false)
end)
